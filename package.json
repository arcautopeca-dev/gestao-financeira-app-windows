{
  "name": "gestao-financeira",
  "productName": "Gestão Financeira",
  "version": "1.0.0",
  "description": "Contas a pagar, contas a receber e fluxo de caixa",
  "main": "main.js",
  "author": "Gestão Financeira",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": { "xlsx": "^0.18.5" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "br.com.gestaofinanceira",
    "productName": "Gestão Financeira",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "build/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "language": "1046", "installerLanguages": ["pt_BR"] }
  }
}
