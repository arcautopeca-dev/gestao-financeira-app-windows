{
  "name": "gestao-financeira",
  "productName": "Gestão Financeira",
  "version": "1.0.0",
  "description": "Contas a pagar, contas a receber e fluxo de caixa",
  "main": "main.js",
  "author": {
    "name": "Gestao Financeira",
    "email": "arcautopeca@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.gestaofinanceira",
    "productName": "Gestão Financeira",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "homepage": "https://github.com/arcautopeca-dev/gestao-financeira-app-windows"
}