{
  "name": "agenda-oficina",
  "productName": "Agenda Oficina",
  "version": "1.0.0",
  "description": "Agenda e controle de ordens de serviço para oficina mecânica",
  "license": "MIT",
  "homepage": "https://github.com/arcautopeca-dev/gestao-financeira-app-windows",
  "author": { "name": "Agenda Oficina", "email": "arcautopeca@gmail.com" },
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "br.com.agendaoficina",
    "productName": "Agenda Oficina",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "build/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
